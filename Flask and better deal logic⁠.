# 1. إعداد خادم Flask لإبقاء البوت نشطاً
app = Flask(__name__)

@app.route('/')
def home():
    return "EcomSpy Bot is Alive and Running!"

def run_flask():
    # Render يحدد المنفذ تلقائياً عبر PORT
    port = int(os.environ.get("PORT", 8080))
    app.run(host='0.0.0.0', port=port)

