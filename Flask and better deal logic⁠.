        "🔹 /deal - الحصول على صفقة ذكية ومغرية فوراً\n"
        "🔹 /top_deals - قائمة بأفضل المنتجات الأكثر فائدة حالياً"
    )
    await update.message.reply_text(welcome_text, parse_mode='Markdown')

async def get_deal(update: Update, context: ContextTypes.DEFAULT_TYPE):
    # اختيار منتج عشوائي متجدد لضمان عدم التكرار
    product = random.choice(PRODUCTS_DATABASE)
    
    msg = (
        f"🔥 **صفقة ممتازة واختيار ذكي!**\n\n"
        f"📌 **المنتج:** {product['title']}\n"
        f"🛒 **المتجر:** {product['store']}\n"
        f"💰 **السعر السابـق:** ~{product['old_price']}~\n"
        f"✅ **السعر الحالي:** **{product['new_price']}**\n\n"
        f"💡 **لماذا هذا المنتج مفيد؟**\n{product['utility']}\n\n"
        f"🔗 [اضغط هنا للشراء أو معاينة المنتج]({product['url']})"
    )
    await update.message.reply_text(msg, parse_mode='Markdown', disable_web_page_preview=False)

async def top_deals(update: Update, context: ContextTypes.DEFAULT_TYPE):
    deals_text = "🎯 **أفضل 3 منتجات مغرية وذات فائدة عالية اليوم:**\n\n"
    selected_products = random.sample(PRODUCTS_DATABASE, min(3, len(PRODUCTS_DATABASE)))
    
    for i, p in enumerate(selected_products, 1):
        deals_text += (
            f"**{i}. {p['title']}**\n"
            f"💵 السعر: **{p['new_price']}** (بدلاً من {p['old_price']})\n"
            f"🎯 الفائدة: {p['utility']}\n"
            f"🔗 [رابط المنتج]({p['url']})\n\n"
        )
    await update.message.reply_text(deals_text, parse_mode='Markdown')

def main():
    # تشغيل خادم Web لتفادي التوقف
    server_thread = Thread(target=run_flask)
    server_thread.daemon = True
    server_thread.start()

    # تشغيل البوت
    application = Application.builder().token(BOT_TOKEN).build()
    application.add_handler(CommandHandler("start", start))
    application.add_handler(CommandHandler("deal", get_deal))
    application.add_handler(CommandHandler("top_deals", top_deals))

    print("Bot is running...")
    application.run_polling()

if __name__ == "__main__":
    main()
