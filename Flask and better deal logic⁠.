BOT_TOKEN = os.environ.get("BOT_TOKEN", "8705649923:AAGb8DYmtYle2a5MBI_1pnRqPwoeQ7IDnK4")

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    welcome_text = (
        "🤖 **مرحباً بك في EcomSpy Bot!**\n\n"
        "أنا المساعد الذكي لاكتشاف أفضل الصفقات والمنتجات عالية الفائدة من المتاجر العالمية بأسعار مخفضة.\n\n"
